# Include AFTER the application's project() call. No application API changes.
if(NOT IDF_TARGET STREQUAL "esp32s3")
    message(FATAL_ERROR "libespnow replacement supports only the pinned esp32s3 ABI")
endif()
if(NOT IDF_VERSION_MAJOR EQUAL 6 OR NOT IDF_VERSION_MINOR EQUAL 0 OR NOT IDF_VERSION_PATCH EQUAL 3)
    message(FATAL_ERROR "libespnow replacement requires ESP-IDF 6.0.3")
endif()
if(NOT TARGET esp_wifi_espnow)
    message(FATAL_ERROR "Pinned imported target esp_wifi_espnow was not found")
endif()
idf_component_get_property(espnow_component libespnow COMPONENT_LIB)
if(NOT TARGET ${espnow_component})
    message(FATAL_ERROR "Add libespnow to EXTRA_COMPONENT_DIRS before project()")
endif()
get_target_property(espnow_build_dir ${espnow_component} BINARY_DIR)
get_target_property(espnow_archive_name ${espnow_component} OUTPUT_NAME)
set(espnow_replacement "${espnow_build_dir}/${CMAKE_STATIC_LIBRARY_PREFIX}${espnow_archive_name}${CMAKE_STATIC_LIBRARY_SUFFIX}")
set_property(TARGET esp_wifi_espnow PROPERTY IMPORTED_LOCATION "${espnow_replacement}")
message(STATUS "ESP-NOW vendor archive replaced by ${espnow_replacement}")
